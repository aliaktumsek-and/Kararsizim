# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True for local development, False in production.
DEBUG=True

# Supabase -> Connect -> Transaction pooler (port 6543). Copy the exact string from the dashboard
# (the host below is only an example) and put your DB password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.ehkeupuuvzmowyedheaj:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Comma-separated. Vercel hostnames are added automatically from VERCEL_* env vars.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
